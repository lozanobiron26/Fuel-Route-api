{
  "info": {
    "name": "Fuel Route API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Plan route – New York → Los Angeles (GET)",
      "request": {
        "method": "GET",
        "description": "Coast to coast: several fuel stops.",
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    },
    {
      "name": "Plan route – Chicago → Denver (POST JSON)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\",\n  \"include_geometry\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        }
      }
    },
    {
      "name": "Short trip – Dallas → Austin (single stop)",
      "request": {
        "method": "GET",
        "description": "",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Dallas, TX&finish=Austin, TX&include_geometry=false",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Dallas, TX"
            },
            {
              "key": "finish",
              "value": "Austin, TX"
            },
            {
              "key": "include_geometry",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "ZIP / coordinates input",
      "request": {
        "method": "GET",
        "description": "Seattle ZIP to Phoenix coordinates.",
        "url": {
          "raw": "{{base_url}}/api/route/?start=98101&finish=33.4484,-112.0740&include_geometry=false",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "98101"
            },
            {
              "key": "finish",
              "value": "33.4484,-112.0740"
            },
            {
              "key": "include_geometry",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "Strictly cheapest plan (no stop penalty)",
      "request": {
        "method": "GET",
        "description": "",
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA&stop_penalty_usd=0&include_geometry=false",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            },
            {
              "key": "stop_penalty_usd",
              "value": "0"
            },
            {
              "key": "include_geometry",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "Error – location outside USA (400)",
      "request": {
        "method": "GET",
        "description": "",
        "url": {
          "raw": "{{base_url}}/api/route/?start=48.8566,2.3522&finish=Denver, CO",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "48.8566,2.3522"
            },
            {
              "key": "finish",
              "value": "Denver, CO"
            }
          ]
        }
      }
    },
    {
      "name": "Map view (open map_url in a browser)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/map/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            "map",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/health/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health",
            ""
          ]
        }
      }
    }
  ]
}